# Porta em que a API vai rodar
PORT=3333

# String de conexão do MongoDB
# Local (MongoDB instalado ou via docker compose):
MONGODB_URI=mongodb://localhost:27017/gestao-estoque
# MongoDB Atlas (substitua usuário, senha e cluster):
# MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/gestao-estoque?retryWrites=true&w=majority

# Origem do frontend autorizada pelo CORS
CORS_ORIGIN=http://localhost:3000